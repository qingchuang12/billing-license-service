# =============================================================================
# 环境变量模板（入库文件 —— 只放占位符，禁止填写任何真实密钥）
#
# 用法：cp .env.example .env ，然后把所有 __CHANGE_ME__ 替换为真实值。
#       .env 已被 .gitignore 忽略、不会入库；本模板是它在版本库中的唯一记录。
#
# ⚠️ 重要变更（2026-09-16 起）：application.yml 已加入
#        spring.config.import: optional:file:.env[.properties]
#    即 .env 已被接成 Spring Boot 的配置源。因此本模板不只是 docker compose 的
#    变量替换表，它直接决定本地 Spring Boot 能否启动 —— 标注为【必填】的项缺失，
#    应用会按 fail-fast 语义直接拒启。
#
# 生成密钥：openssl rand -base64 48
# =============================================================================


# -----------------------------------------------------------------------------
# 【必填】安全密钥 —— 缺失或不合法即启动失败，请勿带着占位符上线
# -----------------------------------------------------------------------------
# 账号体系用户令牌签名密钥（HS256），要求 ≥ 32 字节。
# 缺失 → JwtTokenService 构造器抛 IllegalStateException，整条依赖链拒启。
ACCOUNT_JWT_SECRET=__CHANGE_ME__

# 管理端 API 密钥（X-API-Key 请求头），多个用英文逗号分隔。
ADMIN_API_KEYS=__CHANGE_ME__

# 数据库口令。注：docker compose 会用它初始化 postgres 容器，
# 若保持占位符，compose 会以该占位符作为库密码启动（仅限本机试用，勿用于任何共享环境）。
DB_PASSWORD=__CHANGE_ME__


# -----------------------------------------------------------------------------
# 数据源 / KMS
# -----------------------------------------------------------------------------
# compose 场景用服务名：jdbc:postgresql://postgres:5432/billing_db
# 本地 Spring Boot 场景一般用 127.0.0.1 或 SSH 隧道端口
DB_URL=jdbc:postgresql://postgres:5432/billing_db
DB_USERNAME=postgres

# 本地联调：签名密钥路径（密钥放 keys/ 目录，该目录不入库，见 keys/README.md）
PRIVATE_KEY_PATH=./keys/private.key
PUBLIC_KEY_PATH=./keys/public.key


# -----------------------------------------------------------------------------
# 账号体系 · 可选覆盖（application.yml 内均有默认值，不配也能跑）
# -----------------------------------------------------------------------------
# 令牌有效期（小时），默认 168（7 天）
# ACCOUNT_TOKEN_TTL_HOURS=168

# 注册是否强制邮箱验证码，默认 true
# ACCOUNT_REQUIRE_EMAIL_VERIFICATION=true

# SMTP 未配置时置 true：验证码只写日志、不发邮件，避免注册/找回密码链路被静默卡死
# ACCOUNT_CODE_LOG_ONLY=true

# 验证码哈希 pepper，生产必配（防止库被读后彩虹表反查 6 位数字）
# ACCOUNT_CODE_PEPPER=


# -----------------------------------------------------------------------------
# 格式约束（同时兼容 Spring Boot properties loader / shell source / docker compose）
#   严格 KEY=value；不加 export 前缀；不给值加引号；等号两侧不留空格；# 开头为注释。
# 坑：写了但【值为空】的行会用空值覆盖 application.yml 的默认值，
#     想沿用默认值就把该行注释掉，而不是留空。
# -----------------------------------------------------------------------------
