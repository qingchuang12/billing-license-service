# Compiled and build artifacts
*.class
*.o
*.obj
*.out
build/
target/

# Dependencies
.gradle/
lib/
libs/

# Logs and temp files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/
*.iml
*.ipr
*.iws

# Environment
.env
.env.local
*.env.*

# Coverage reports
coverage/
htmlcov/
*.coverage

# OS generated files
.DS_Store
Thumbs.db

# Local signing keys (mounted into container at runtime, never commit)
keys/
*.key

# Force-include the env template (override the *.env.* ignore above)
!.env.example
.workbuddy

